# Google OAuth — 각자 로컬 전용 클라이언트를 발급해 채운다 (LOCALDEPLOY.md)
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret

# 아래는 application.yml의 local 기본값을 쓴다. 바꿀 때만 주석 해제.

# AI 서버 없이 채팅을 보려면 켠다 (고정 delta fake 어댑터)
#AI_FAKE_STREAM=true

# JWT 서명 시크릿 (HS256, 32바이트 이상)
#AUTH_JWT_SECRET=local-dev-only-secret-key-32bytes-min!!

# DB — 컨테이너 실행 시 DB_URL은 compose.yml이 ymc-postgres로 덮는다
#DB_URL=jdbc:postgresql://localhost:5432/ymc_dev
#DB_USERNAME=ymc
#DB_PASSWORD=1234
